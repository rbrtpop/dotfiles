#!/usr/bin/env bash

set -euo pipefail

dry_run=0
mise_bin="${MISE_INSTALL_PATH:-${HOME}/.local/bin/mise}"
# The mise release that setup installs. Change the version and the installer
# digest together: the digest is the sha256 of install.sh from that GitHub
# release. Setup refuses an installer whose digest does not match.
pinned_mise_version=2026.10.19
pinned_installer_sha256=82d35715f9d54b9ca4ff5b909ebeb4f4ded457d4fae15814db2fe6da5b943e1f
mise_bin_dir="$(dirname "$mise_bin")"

log() {
  printf '==> %s\n' "$1"
}

warn() {
  printf '!! %s\n' "$1" >&2
}

usage() {
  printf 'Usage: ./bin/ensure-mise-standalone [--dry-run]\n' >&2
}

load_homebrew_shellenv() {
  if [[ -n "${HOMEBREW_PREFIX:-}" && -x "${HOMEBREW_PREFIX}/bin/brew" ]]; then
    eval "$("${HOMEBREW_PREFIX}/bin/brew" shellenv)"
    return 0
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
  fi
}

# Prints the installed version, such as 2026.10.19. An older mise can refuse
# the current config, so the config is not loaded.
installed_mise_version() {
  local output
  [[ -x "$mise_bin" ]] || return 1
  output="$(cd / && MISE_GLOBAL_CONFIG_FILE=/dev/null MISE_SELF_UPDATE_AUTO=0 "$mise_bin" --version 2>/dev/null)" || return 1
  output="${output%% *}"
  [[ "$output" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$output"
}

# Succeeds when the standalone mise is the pinned release or newer.
standalone_mise_ok() {
  local version
  version="$(installed_mise_version)" || return 1
  awk -v have="$version" -v want="$pinned_mise_version" 'BEGIN {
    split(have, h, "."); split(want, w, ".")
    for (i = 1; i <= 3; i++) {
      if (h[i] + 0 > w[i] + 0) exit 0
      if (h[i] + 0 < w[i] + 0) exit 1
    }
    exit 0
  }'
}

brew_mise_installed() {
  load_homebrew_shellenv

  if ! command -v brew >/dev/null 2>&1; then
    return 1
  fi

  brew list --formula --versions mise >/dev/null 2>&1
}

install_standalone_mise() {
  local work_dir installer digest status=0
  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would install mise ${pinned_mise_version} from its GitHub release after checking the installer digest"
    return 0
  fi

  log "Installing mise ${pinned_mise_version} standalone"
  mkdir -p "$mise_bin_dir"
  work_dir="$(mktemp -d)"
  installer="${work_dir}/install.sh"
  if ! curl -fsSL --connect-timeout 15 --max-time 120 --retry 2 -o "$installer" \
    "https://github.com/jdx/mise/releases/download/v${pinned_mise_version}/install.sh"; then
    warn "Could not download the mise ${pinned_mise_version} installer"
    rm -rf "$work_dir"
    return 1
  fi
  digest="$(/usr/bin/shasum -a 256 "$installer")"
  digest="${digest%% *}"
  if [[ "$digest" != "$pinned_installer_sha256" ]]; then
    warn "The mise installer checksum does not match; refusing to run it"
    rm -rf "$work_dir"
    return 1
  fi
  MISE_VERSION="v${pinned_mise_version}" MISE_INSTALL_PATH="$mise_bin" MISE_INSTALL_HELP=0 sh "$installer" || status=$?
  rm -rf "$work_dir"
  return "$status"
}

verify_standalone_mise() {
  local mise_path mise_version

  export PATH="${mise_bin_dir}:${PATH}"
  hash -r 2>/dev/null || true

  mise_path="$(command -v mise || true)"
  if [[ "$mise_path" != "$mise_bin" ]]; then
    warn "mise resolves to ${mise_path:-missing}, expected ${mise_bin}"
    return 1
  fi

  if ! mise --version >/dev/null 2>&1; then
    warn "mise --version failed for ${mise_bin}"
    return 1
  fi

  if ! mise self-update --help >/dev/null 2>&1; then
    warn "mise self-update --help is unavailable; mise may still be package-manager owned"
    return 1
  fi

  mise_version="$(mise --version)"
  log "mise command: ${mise_path}"
  log "mise version: ${mise_version}"
  log "mise self-update is available"
}

uninstall_brew_mise() {
  if ! brew_mise_installed; then
    return 0
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    log "dry-run: would uninstall Homebrew formula mise after standalone verification succeeds"
    return 0
  fi

  log "Uninstalling Homebrew formula mise"
  brew uninstall mise
  hash -r 2>/dev/null || true
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

export PATH="${mise_bin_dir}:${PATH}"

if standalone_mise_ok; then
  log "mise standalone ${pinned_mise_version} or newer is already present"
else
  install_standalone_mise
fi

if [[ "$dry_run" -eq 1 ]]; then
  log "dry-run: would verify mise command, version, and self-update availability"
  uninstall_brew_mise
  exit 0
fi

verify_standalone_mise
uninstall_brew_mise
verify_standalone_mise
